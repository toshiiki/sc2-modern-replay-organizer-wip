<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <Folders>
    <LookupFolder>
      <Path dir="C:\Users\YOUR_USERNAME\Documents\StarCraft II\Accounts\YOUR_ACCOUNT_ID\YOUR_REPLAY_FOLDER\Replays\Multiplayer\00-organized\" subdirs="yes" />
    </LookupFolder>
    <SaveTo>
      <Path dir="" action="overwrite" />
    </SaveTo>
  </Folders>
  <Match>
    <SpecificPlayer set="yes" name="YOUR_USERNAME" sort="yes" />
    <LadderOnly set="no" />
  </Match>
  <Rules>
    <RenameOriginal set="yes" />
    <CopyToLocation set="no" />
    <DeleteOriginal set="no" />
    <DeleteNon1V1 set="no" />
    <FilePattern value="[DATE] - [TIME]_ [P1NAME]([P1R]) vs [P2NAME]([P2R]) on [MAP].[EXT]" />
  </Rules>
  <DemoPatterns>
    <Pattern value="[ORIGINAL].[EXT]" />
    <Pattern value="[DATE] [P1NAME]([P1R]) vs [P2NAME]([P2R]) on [MAP].[EXT]" />
    <Pattern value="[[DATE]][[T]] [MATCHUP] [MAP] - [P1NAME] vs [P2NAME].[EXT]" />
    <Pattern value="[[DATE]-[TIME]] [MATCHUP] [MAP] - [P1NAME] vs [P2NAME].[EXT]" />
    <Pattern value="[DATE] [ORIGINAL].[T].[EXT]" />
  </DemoPatterns>
  <Debug set="no" />
</Configuration>
